<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ZRemote.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_bg</item>
        <item name="colorAccent">@color/accent_bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
    </style>

    <style name="Theme.ZRemote" parent="Theme.ZRemote.Base">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 扫码页：全屏相机，始终黑底白字 -->
    <style name="Theme.ZRemote.Scan" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>